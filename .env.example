# OSINT Sentinel Workstation — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's gitignored).

# ── Optional: NASA FIRMS fire data (free, register at firms.modaps.eosdis.nasa.gov) ──
FIRMS_MAP_KEY=

# ── Optional: Visentrix license server (for online activation/validation) ──
# If not set, offline activation is used (any well-formed key accepted in dev)
VISENTRIX_LICENSE_SERVER=

# ── Optional: Cesium Ion access token (for premium terrain/imagery) ──
# If not set, the app uses free GIBS/OpenStreetMap/ArcGIS imagery
CESIUM_ION_TOKEN=

# ── Optional: Ollama host (default: http://localhost:11434) ──
OLLAMA_HOST=http://localhost:11434

# ── Optional: CLIP server host (default: http://localhost:9776) ──
CLIP_SERVER_HOST=http://localhost:9776
